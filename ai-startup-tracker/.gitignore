# ── Revelio (LinkedIn) data — huge raw parquet + founder-level PII ──
# Raw shards: never commit (100s of GB, deleted after streaming filter).
data/revelio_raw/
# Person-level derived tables carry founder names/schools (PII) — keep local
# / in DB only; commit ONLY the aggregate CSVs under output/.
data/revelio_derived/
founder_poc/founder_profiles.parquet
founder_poc/*_poc.parquet
# ALL founder parquets carry person-level PII (names, LinkedIn URLs,
# gender/ethnicity) — never commit. Paths need the scripts/ prefix to match
# from the repo root. Manifests (*.json, shard counts only) are fine to commit.
scripts/founder_poc/*.parquet
data/pb_longitudinal/

# CORDIS bulk archives (90MB, re-downloadable)
data/cordis/

# SBIR bulk award file (350MB, re-downloadable)
data/sbir/
